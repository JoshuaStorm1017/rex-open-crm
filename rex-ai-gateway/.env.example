# Copy to .env only when forwarding creates to a real Twenty workspace.
# The mock client needs none of these. Do not commit .env.

# Gateway listen address. Defaults are 127.0.0.1:8787.
REX_AI_GATEWAY_HOST=localhost
REX_AI_GATEWAY_PORT=8787

# Twenty base URL, no trailing path. Leave unset to keep the in-memory mock.
TWENTY_API_URL=http://localhost:3000

# Ignored. Writes use the signed-in member session or X-Twenty-Authorization.
# TWENTY_API_KEY=

# Gateway workspace token. When set, requests must use this workspaceId.
# This is the gateway's own token (ws_*), not Twenty's internal workspace uuid.
TWENTY_WORKSPACE_ID=ws_demo

# rest  → POST /rest/people, /rest/companies, /rest/opportunities
# graphql → POST /graphql createPerson / createCompany / createOpportunity
TWENTY_API_STYLE=rest

# Leave unset for local dev on 127.0.0.1. Required when REX_AI_GATEWAY_HOST is not loopback.
# Service callers send Authorization: Bearer <this token> and X-Twenty-Authorization: Bearer <member access token>.
# The Twenty web app does not receive this value. Do not put it in window._env_.
REX_AI_GATEWAY_TOKEN=

# SQLite file for previews, idempotency keys, and the audit log. Default: data/gateway-state.sqlite
# REX_AI_STATE_PATH=

# Browser origins allowed to call the gateway. Unset allows the local Twenty app.
# A wildcard is not accepted.
# REX_AI_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# mock (default, no network) or openai (any OpenAI-compatible Chat Completions API).
# REX_AI_BASE_URL must be a public http(s) origin. Loopback, private, and metadata addresses are refused.
REX_AI_PROVIDER=mock
REX_AI_BASE_URL=https://api.openai.com/v1
REX_AI_API_KEY=
REX_AI_MODEL=gpt-4o-mini
