# Copy to .env only when forwarding creates to a real Twenty workspace.
# The mock client needs none of these. Do not commit .env.

# Gateway listen address. Defaults are 127.0.0.1:8787.
REX_AI_GATEWAY_HOST=127.0.0.1
REX_AI_GATEWAY_PORT=8787

# Twenty base URL, no trailing path. Example: http://localhost:3000
TWENTY_API_URL=http://localhost:3000

# Workspace API key (Settings → APIs & Webhooks). Leave empty in this example.
TWENTY_API_KEY=

# Gateway workspace token. When set, POST /v1/ai/act must use this workspaceId.
# This is the gateway's own token (ws_*), not Twenty's internal workspace uuid.
TWENTY_WORKSPACE_ID=ws_demo

# rest  → POST /rest/people, /rest/companies, /rest/opportunities
# graphql → POST /graphql createPerson / createCompany / createOpportunity
TWENTY_API_STYLE=rest

# Leave unset for local dev. When set, every route requires Authorization: Bearer.
REX_AI_GATEWAY_TOKEN=

# mock (default, no network) or openai (any OpenAI-compatible Chat Completions API).
REX_AI_PROVIDER=mock
REX_AI_BASE_URL=https://api.openai.com/v1
REX_AI_API_KEY=
REX_AI_MODEL=gpt-4o-mini
