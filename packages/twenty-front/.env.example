REACT_APP_SERVER_BASE_URL=http://localhost:3000
VITE_BUILD_SOURCEMAP=false


# ———————— Optional ————————
# REACT_APP_PORT=3001
# VITE_ENABLE_SSL=false
# VITE_HOST=localhost.com
# SSL_KEY_PATH="./certs/your-cert.key"
# SSL_CERT_PATH="./certs/your-cert.crt"
# IS_DEBUG_MODE=false

# AI command bar (Ctrl+Shift+K). Defaults are the local mock gateway.
# Injected through window._env_ when you set them on the server that serves index.html.
# REX_AI_GATEWAY_URL=http://127.0.0.1:8787
# REX_AI_WORKSPACE_ID=ws_demo
# REX_AI_GATEWAY_TOKEN=